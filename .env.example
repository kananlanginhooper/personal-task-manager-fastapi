# Copy to .env (never commit it) and fill in. docker compose reads it.
# Database: the shared MySQL server. Laptop and server use the same host.
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_NAME=gameplan
DB_USER=gameplan
DB_PASSWORD=CHANGE_ME
# Or give one full URL instead (it wins over the DB_* values). Leave both unset for local SQLite.
# DATABASE_URL=mysql+pymysql://gameplan:CHANGE_ME@CHANGE_ME:3306/gameplan

# Where the app lives. Only these change when it moves from http://<host>:<port> to https://<app>.<domain>.
PUBLIC_URL=http://localhost:8095
UI_BASE_PATH=/
# Home dashboards wrapper origins allowed to show the app in an iframe (laptop wrapper, server wrapper, later its subdomain).
FRAME_ANCESTORS=http://localhost:8097 http://192.0.2.10:8097
# Reverse proxies whose X-Forwarded-* headers are trusted.
FORWARDED_ALLOW_IPS=127.0.0.1
# Login (OIDC Authorization Code + PKCE) once the IdP is live.
LOGIN=off
OIDC_ISSUER=
OIDC_CLIENT_ID=

CORS_ORIGINS=http://localhost:4200
# Port the container publishes on the host, and the one IPv4 address it publishes on
# (the server's LAN address on a server, 127.0.0.1 on a laptop).
API_PORT=8095
BIND_ADDR=127.0.0.1
# Optional: require "Authorization: Bearer <token>" on every /api call.
API_TOKEN=
